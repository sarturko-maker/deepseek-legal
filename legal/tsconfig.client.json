{
  "compilerOptions": {
    "target": "ES2024", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true, "declaration": true,
    "rootDir": "src", "outDir": "lib/types", "types": ["react"], "lib": ["ES2024", "DOM", "DOM.Iterable"]
  },
  "include": ["src/client"]
}
