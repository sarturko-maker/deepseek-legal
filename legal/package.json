{
  "name": "@deepseek-legal/redlining",
  "version": "0.1.0",
  "description": "Tracked contract amendments for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sarturko-maker/deepseek-legal.git",
    "directory": "legal"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.7.0",
  "main": "dist/index.js",
  "exports": {
    "./editor/types": { "types": "./lib/types/editor/types.d.ts", "default": "./dist/editor/types.js" },
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "types": "./lib/types/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "editor",
    "skills",
    "playbooks",
    "README.md",
    "README.zh.md",
    "README.i18n.yaml",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.host.json && tsdown && tsx scripts/generate.ts && tsc -p tsconfig.client.json && tsdown --config tsdown.client.config.ts --env.DSH_BUILD_FACE client",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.host.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json"
  },
  "dependencies": {
    "@adeu/core": "3.0.6",
    "fflate": "0.8.3",
    "zod": "4.4.3",
    "@xmldom/xmldom": "0.9.12"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-workspace-files": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-gateway": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-workspace-files": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-right": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "link:../vendor/loader",
    "@deepseek-ai/cordis-plugin-include": "link:../vendor/include",
    "@deepseek-ai/dsh-agent": "link:../packages/core/agent",
    "@deepseek-ai/dsh-agent-loop": "link:../packages/core/agent-loop",
    "@deepseek-ai/dsh-app-boot": "link:../packages/boot/app-boot",
    "@deepseek-ai/dsh-llm": "link:../packages/llm/llm",
    "@deepseek-ai/dsh-system-prompt": "link:../packages/core/system-prompt",
    "@deepseek-ai/dsh-session-projection": "link:../packages/session/session-projection",
    "@deepseek-ai/dsh-fs-local": "link:../packages/fs/fs-local",
    "@deepseek-ai/dsh-host-webserver": "link:../packages/host/webserver",
    "@deepseek-ai/cordis": "link:../vendor/cordis",
    "@deepseek-ai/dsh-atomic-write": "link:../packages/util/atomic-write",
    "@deepseek-ai/dsh-brand": "link:../packages/util/brand",
    "@deepseek-ai/dsh-session": "link:../packages/core/session",
    "@deepseek-ai/dsh-tools": "link:../packages/core/tools",
    "@deepseek-ai/dsh-fs": "link:../packages/fs/fs",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "tsdown": "^0.21.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.0",
    "vite-tsconfig-paths": "^6.0.0",
    "ws": "8.21.0",
    "@deepseek-ai/dsh-api-gateway": "link:../packages/api/gateway",
    "@deepseek-ai/dsh-api-workspace-files": "link:../packages/api/workspace-files",
    "@deepseek-ai/dsh-typert-protocol": "link:../packages/typert/protocol",
    "@deepseek-ai/dsh-client-locale": "link:../packages/client/locale",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-session": "link:../packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "link:../packages/client/ui-sidebar-right",
    "@deepseek-ai/dsh-client-ui-sidebar-documentpreview": "link:../packages/client/ui-sidebar-documentpreview",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../packages/client/ui-primitives",
    "react": "18.3.1",
    "@types/react": "^18.3.0",
    "tsx": "4.22.4"
  }
}
